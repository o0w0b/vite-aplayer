{
    "name": "vite-aplayer",
    "version": "1.0.0",
    "description": "APlayer, with both ESM and UMD builds.",
    "main": "dist/APlayer.umd.js",
    "module": "dist/APlayer.esm.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/APlayer.esm.js",
            "require": "./dist/APlayer.umd.js"
        },
        "./dist/APlayer.min.css": "./dist/APlayer.min.css"
    },
    "style": "dist/APlayer.min.css",
    "dependencies": {
        "nunjucks": "^3.2.4",
        "promise-polyfill": "^8.3.0",
        "smoothscroll": "^0.4.0"
    },
    "devDependencies": {
        "autoprefixer": "^10.4.0",
        "eslint": "^9.39.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.4",
        "postcss": "^8.5.6",
        "postcss-cli": "^11.0.1",
        "prettier": "^3.7.4",
        "prettier-check": "^2.0.0",
        "pretty-quick": "^4.2.2",
        "sass": "^1.63.0",
        "terser": "^5.36.0",
        "typescript": "^5.9.3",
        "vite": "^7.2.7",
        "vite-plugin-dts": "^4.5.4"
    },
    "scripts": {
        "dev": "yarn build && vite --port 3000",
        "build": "vite build && yarn build:css",
        "build:css": "postcss dist/APlayer.min.css -o dist/APlayer.min.css --map",
        "test": "eslint src",
        "format": "eslint \"**/*.js\" --fix && prettier \"**/*.{js,json,md}\" --write",
        "format:staged": "eslint \"**/*.js\" --fix && pretty-quick --staged --verbose --pattern \"**/*.{js,json,md}\"",
        "format:check": "eslint \"**/*.js\" && prettier-check \"**/*.{js,json,md}\""
    },
    "files": [
        "dist/*.js",
        "dist/*.css",
        "dist/*.map",
        "dist/index.d.ts"
    ],
    "keywords": [
        "player",
        "music",
        "html5",
        "vite"
    ],
    "author": "o0w0b",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/o0w0b/vite-aplayer.git"
    },
    "bugs": {
        "url": "https://github.com/o0w0b/vite-aplayer/issues"
    },
    "homepage": "https://github.com/o0w0b/vite-aplayer#readme"
}